# Copiar a .env y completar. .env no se sube al repo.
PORT=3000
NODE_ENV=development
MONGODB_URI=
# Base separada para tests; su nombre debe contener "test" (se borra en cada corrida).
MONGODB_URI_TEST=
# Mínimo 32 caracteres aleatorios. Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173

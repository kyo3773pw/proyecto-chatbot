# Copiar a .env y completar. .env no se sube al repo.
PORT=3000
NODE_ENV=development
MONGODB_URI=
# Base separada para tests; su nombre debe contener "test" (se borra en cada corrida).
MONGODB_URI_TEST=
# Mínimo 32 caracteres aleatorios. Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173
# Opcional: extracción de eventos desde texto con LLM. Sin clave, la app arranca igual y solo esa función responde error.
# Clave en https://aistudio.google.com (no subirla nunca). Modelo: un Flash-Lite de texto, ej. gemini-3.5-flash-lite.
GEMINI_API_KEY=
LLM_MODEL=
